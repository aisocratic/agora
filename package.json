{
  "name": "agora-board",
  "version": "0.1.0",
  "description": "A kanban board built for humans and coding agents",
  "license": "MIT",
  "author": "AI Socratic (https://aisocratic.org)",
  "homepage": "https://github.com/aisocratic/agora",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aisocratic/agora.git"
  },
  "keywords": [
    "kanban",
    "agents",
    "claude-code",
    "codex",
    "project-management",
    "self-hosted",
    "postgres"
  ],
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "pnpm design:check && pnpm typecheck && pnpm lint && pnpm test",
    "design:sync": "node scripts/sync-design.mjs",
    "design:check": "node site/scripts/sync-design.mjs --check",
    "site:build": "node scripts/build-site.mjs"
  },
  "dependencies": {
    "@aisocratic/design": "file:vendor/aisocratic-design-0.2.0.tgz",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-slot": "1.2.4",
    "cmdk": "1.0.4",
    "lucide-react": "^1.29.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "react": "^19",
    "react-dom": "^19",
    "sonner": "^2.0.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.9",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
