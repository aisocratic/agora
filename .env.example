# Optional: unset DATABASE_URL for the personal browser board.
DATABASE_URL=postgres://agora:agora@localhost:5432/agora
# DATABASE_SSL=require       # verified TLS for managed Postgres
# DATABASE_POOL_MAX=10       # integer 1–100

# Shared access requires an explicit mode. Production always rejects none.
# Password mode: random password >=16 characters, distinct session secret >=32.
AGORA_AUTH=password
AGORA_ACCESS_PASSWORD=
AGORA_SESSION_SECRET=
# Exact browser-facing origin; required in production. HTTPS except loopback.
AGORA_PUBLIC_ORIGIN=https://board.example.com
# Optional attribution for the shared password/local user.
# AGORA_USER_NAME=you

# Named full-access API tokens: comma-separated name:secret, each secret >=32.
# Generate real secrets with openssl rand -hex 32. See docs/AUTH.md.
# AGORA_API_TOKENS=claude:REPLACE_WITH_A_RANDOM_SECRET,ci:REPLACE_WITH_ANOTHER_SECRET

# Trusted proxy mode requires BOTH headers from an authenticated private proxy.
# The proxy must strip incoming copies before setting these upstream values.
# AGORA_AUTH=proxy
# AGORA_TRUSTED_USER_HEADER=X-Authenticated-User
# AGORA_PROXY_SECRET=         # random >=32, sent as X-Agora-Proxy-Secret

# Local shared development only: AGORA_AUTH=none with pnpm dev (loopback bind).
# Never expose or proxy the unauthenticated development listener.

# Optional trusted complete JSON configuration override (see docs/CONFIGURATION.md).
# AGORA_CONFIG_FILE=/absolute/path/agora.json
# Dispatcher credential names are selected in agora.config.ts (see docs/DISPATCH.md).
# AGORA_WEBHOOK_SECRET=
# AGORA_GITHUB_TOKEN=
# AGORA_ALLOW_COMMAND_DISPATCH=1
