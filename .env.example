# ---------------------------------------------------------------- database
# The only required variable. Any Postgres 14+ will do: the docker-compose
# service in this repo, or a managed instance (Neon, Supabase, RDS, Fly).
DATABASE_URL=postgres://agora:agora@localhost:5432/agora

# Managed Postgres almost always wants TLS. Leave unset for local docker.
# DATABASE_SSL=require

# Lower this to 3 or so on a serverless Postgres with a small connection cap.
# DATABASE_POOL_MAX=10

# ------------------------------------------------------------------- auth
# none      no login at all. The default, and correct for localhost.
# password  a single shared password, set AGORA_ACCESS_PASSWORD below.
# proxy     trust an identity header from a reverse proxy you control.
#
# `none` is refused in production unless you set it explicitly — see docs/AUTH.md.
# AGORA_AUTH=password
# AGORA_ACCESS_PASSWORD=
# AGORA_SESSION_SECRET=            # 32+ random bytes; required when AGORA_AUTH=password
# AGORA_TRUSTED_USER_HEADER=       # e.g. X-Forwarded-Email, when AGORA_AUTH=proxy

# The name new cards and comments are attributed to when there is no account
# system in play (there isn't — see the README on the trust boundary).
# AGORA_USER_NAME=you

# --------------------------------------------------------- machine access
# Tokens for the CLI, agents, and editor extensions. Comma-separated
# `name:secret` pairs; each secret must be at least 32 characters.
#   openssl rand -hex 32
# AGORA_API_TOKENS=cli:...,ci:...

# ------------------------------------------------------------- dispatching
# Only needed when agora.config.ts sets a dispatcher other than "none".
# AGORA_WEBHOOK_SECRET=
# AGORA_ALLOW_COMMAND_DISPATCH=1   # required opt-in for the `command` adapter:
#                                  # it executes a process on your server
